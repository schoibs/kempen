# Application runtime
CAMPAIGN_ENVIRONMENT=local
CAMPAIGN_LOG_LEVEL=INFO
CAMPAIGN_FAKE_PROVIDER_MODE=true

# Local Docker Compose infrastructure
CAMPAIGN_DATABASE_URL=postgresql+psycopg://campaign:campaign@localhost:5432/campaign
CAMPAIGN_REDIS_URL=redis://localhost:6379/0
CAMPAIGN_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
CAMPAIGN_OBJECT_STORAGE_REGION=us-east-1
CAMPAIGN_OBJECT_STORAGE_BUCKET=campaign-assets
CAMPAIGN_OBJECT_STORAGE_ACCESS_KEY=campaign-local
CAMPAIGN_OBJECT_STORAGE_SECRET_KEY=campaign-local-secret

# Authentication is implemented in a later phase. Keep disabled locally.
CAMPAIGN_AUTH_ENABLED=false
# CAMPAIGN_OIDC_ISSUER=https://identity.example.com/
# CAMPAIGN_OIDC_AUDIENCE=campaign-api

# Required only when CAMPAIGN_FAKE_PROVIDER_MODE=false.
# OPENAI_API_KEY=
# TINYFISH_API_KEY=
# FAL_KEY=
